# WordPress Auth Service Configuration

# WordPress Configuration
WP_ROOT_URL=https://example.com
APP_NAME=My Application
CALLBACK_URL=https://myapp.com/callback

# API Authentication
# Generate an API key through the admin interface or set one here
API_KEY=

# Cache Configuration
CACHE_TTL=300
# Optional: Redis connection string for distributed caching
# REDIS_URL=redis://localhost:6379/0

# Service Configuration
SERVICE_PORT=8000
SERVICE_HOST=127.0.0.1

# CORS Configuration
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# Logging Configuration
LOG_LEVEL=INFO
